.env
logs/
.pids/

# Go
services/*/bin/

# Rust
services/*/target/

# Java
services/*/target/
services/*/*.class

# Node
services/*/node_modules/
services/*/dist/

# Python
services/*/__pycache__/
**/__pycache__/
*.pyc

# BadgerDB cold-tier data (feed-aggregation-service), rebuildable, not a
# system of record -- see doc/caching.md. Matched wherever it lands
# (cmd/server/data/ if run with that as CWD, or the intended data/ at the
# service root) rather than one hardcoded path.
**/data/cold-tier/

# Envoy dev TLS material -- entirely regenerated by scripts/gen_dev_certs.sh,
# self-signed and local-only. Excluding the whole directory (not just the
# key) keeps the cert/key pair from drifting out of sync in git.
envoy/certs/

# Stray Go build output from running `go build ./cmd/server` without -o
# from a service root (Go defaults the binary name to "server" in cwd) --
# scripts/build_all.sh always uses -o bin/<service>, this is only ever a
# leftover from a manual/ad-hoc build.
services/*/server

# Editor / OS cruft
.idea/
.vscode/
*.swp
.DS_Store

# This tool's own local session state, not project source
.claude/
