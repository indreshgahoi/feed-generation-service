.env
logs/
.pids/

# Go
services/*/bin/

# Rust
services/*/target/

# Java
services/*/target/
services/*/*.class

# Node
services/*/node_modules/
services/*/dist/

# Python
services/*/__pycache__/
**/__pycache__/
*.pyc

# BadgerDB cold-tier data (feed-aggregation-service), rebuildable, not a
# system of record -- see doc/caching.md. Matched wherever it lands
# (cmd/server/data/ if run with that as CWD, or the intended data/ at the
# service root) rather than one hardcoded path.
**/data/cold-tier/

# Envoy dev TLS material -- regenerated by scripts/gen_dev_certs.sh,
# self-signed and local-only, but private keys still don't belong in git
envoy/certs/*.pem
envoy/certs/*.key

# Editor / OS cruft
.idea/
.vscode/
*.swp
.DS_Store
