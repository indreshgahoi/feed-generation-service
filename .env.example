# Copy to .env (already done by setup) and adjust if you changed
# docker-compose ports/credentials. Every service reads this same file.
# Sharded Postgres connection strings live in config/shards.json, NOT
# here -- there is no single POSTGRES_URL anymore. See doc/sharding.md.

# --- Infra endpoints (docker-compose) ---
SHARD_CONFIG_PATH=../../config/shards.json
KAFKA_BROKERS=localhost:9092
QDRANT_URL=http://localhost:6333
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=feedpassword

# --- MinIO (post-ingestion-service) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=ig-media
MINIO_USE_SSL=false

# --- Service ports ---
INGESTION_PORT=4001
FEED_PORT=4002
RANKING_PORT=4003
# gRPC ports for the 2 internal, service-to-service calls that bypass
# Envoy (see doc/gateway.md and doc/wire-protocols.md) -- separate from
# the HTTP ports above, which stay JSON/REST for client-facing traffic.
FEED_AGGREGATION_GRPC_PORT=4102
RANKING_GRPC_PORT=4103

# --- fanout-worker (Java) ---
FEED_INBOX_MAX_ITEMS=800
ACTIVE_WITHIN_DAYS=7
FEED_AGGREGATION_SERVICE_GRPC_ADDR=localhost:4102

# --- feed-aggregation-service (Go) ---
RANKING_SERVICE_GRPC_ADDR=localhost:4103
COLD_TIER_DATA_DIR=./data/cold-tier
IN_NETWORK_CANDIDATE_LIMIT=500
CELEBRITY_CANDIDATE_LIMIT=50
VECTOR_CANDIDATE_LIMIT=250
SEEN_STATE_TTL_SECONDS=172800
FEED_PAGE_SIZE=20
MAX_POSTS_PER_AUTHOR=2
TASTE_SEED_POST_LIMIT=5
FEED_CURSOR_SECRET=change-me-32-byte-local-dev-secret

# --- ranking-service (Rust) -- composite score weights ---
RANK_W_LIKE=1.0
RANK_W_COMMENT=1.5
RANK_W_SHARE=2.0
RANK_W_DWELL=0.8
RANK_W_HIDE=3.0
